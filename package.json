{
  "name": "sequent",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:tsgo": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --fail-on-warnings",
    "doctor": "svelte-doctor check --fail-on warning .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "image:local": "bash scripts/local/build-docker-image.sh",
    "admin:backup": "node scripts/admin/backup.ts",
    "admin:restore": "node scripts/admin/restore.ts",
    "admin:reset-owner": "node scripts/admin/reset-owner.ts",
    "admin:seed-synthetic": "node scripts/admin/seed-synthetic.ts",
    "qualify:codex-runtime": "node scripts/admin/qualify-codex-runtime.ts",
    "qualify:diz-corpus": "node scripts/admin/qualify-diz-corpus.ts",
    "benchmark:extraction-safety": "node scripts/benchmark/extraction-safety.ts",
    "docs:check": "node scripts/check-documentation-consistency.mjs",
    "format:check": "oxfmt --check scripts tests src package.json tsconfig.json svelte.config.js vite.config.ts playwright.config.ts svelte-doctor.config.json",
    "lint": "oxlint scripts tests src",
    "shell:check": "bash -n scripts/local/*.sh scripts/vps/*.sh",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test tests/diz/*.test.ts tests/local/*.test.ts tests/official-sources/*.test.ts tests/vps/*.test.ts && npm run test:unit",
    "test:github": "node --test scripts/github/*.test.mjs",
    "verify:boundary": "node scripts/check-public-boundary.mjs",
    "verify:rapid": "npm run docs:check && npm run format:check && npm run test:github && npm run verify:boundary",
    "verify:application": "npm run lint && npm run shell:check && npm run check && npm run typecheck && npm run check:tsgo && npm test && npm run build",
    "verify:public": "npm run verify:rapid && npm run verify:application",
    "verify:publication": "node scripts/github/verify-publication.mjs",
    "publication:classify": "node scripts/github/publication-policy.mjs",
    "publication:github": "node scripts/github/publication-command.mjs",
    "verify:sources": "node scripts/official-sources/verify.ts",
    "verify:suc13-control": "node scripts/official-sources/qualify-suc13-control.mjs",
    "generate:facsimile-layout": "node scripts/official-sources/generate-facsimile-layout.mjs",
    "generate:municipality-conservatory-map": "node scripts/official-sources/generate-municipality-conservatory-map.ts",
    "generate:successionionline-field-evidence": "node scripts/official-sources/generate-successionionline-field-evidence.ts",
    "generate:operational-parity-map": "node scripts/official-sources/generate-operational-parity-map.ts",
    "render:facsimile-fixture": "node --experimental-strip-types scripts/official-sources/render-facsimile-fixture.ts",
    "diz:compare": "node scripts/diz/compare.ts",
    "diz:inspect": "node scripts/diz/inspect.ts",
    "diz:inventory": "node scripts/diz/inventory.ts"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@lucide/svelte": "1.34.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex-sdk": "0.149.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "pdf-lib": "1.17.1",
    "read-excel-file": "9.3.10",
    "svelte": "5.56.10",
    "unzipper-esm": "0.13.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "fake-indexeddb": "6.2.5",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "svelte-check": "4.7.6",
    "svelte-doctor": "0.3.6",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "engines": {
    "node": "26.7.0",
    "npm": "12.0.2"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": true,
    "fsevents": false
  }
}
