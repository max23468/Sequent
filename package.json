{
  "name": "sequent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "oxfmt --check scripts tests src package.json tsconfig.json",
    "lint": "oxlint scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts",
    "verify:boundary": "node scripts/check-public-boundary.mjs",
    "verify:public": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run verify:boundary",
    "verify:sources": "node scripts/official-sources/verify.ts",
    "diz:inspect": "node scripts/diz/inspect.ts"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  }
}
