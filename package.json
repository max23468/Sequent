{
  "name": "sequent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:tsgo": "svelte-kit sync && tsgo --noEmit -p tsconfig.json",
    "doctor": "svelte-doctor check --fail-on warning .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "admin:backup": "node scripts/admin/backup.ts",
    "docs:check": "node scripts/check-documentation-consistency.mjs",
    "format:check": "oxfmt --check scripts tests src package.json tsconfig.json svelte.config.js vite.config.ts playwright.config.ts svelte-doctor.config.json",
    "lint": "oxlint scripts tests src",
    "shell:check": "bash -n scripts/vps/*.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/diz/*.test.ts tests/official-sources/*.test.ts tests/vps/*.test.ts && npm run test:unit",
    "test:codex-review": "node --test scripts/codex-review-gate.test.mjs",
    "verify:boundary": "node scripts/check-public-boundary.mjs",
    "verify:public": "npm run docs:check && npm run format:check && npm run lint && npm run shell:check && npm run check && npm run check:tsgo && npm test && npm run build && npm run doctor && npm run test:codex-review && npm run verify:boundary",
    "verify:sources": "node scripts/official-sources/verify.ts",
    "diz:compare": "node scripts/diz/compare.ts",
    "diz:inspect": "node scripts/diz/inspect.ts",
    "diz:inventory": "node scripts/diz/inventory.ts"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "svelte": "5.56.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "svelte-check": "4.7.6",
    "svelte-doctor": "0.3.6",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "engines": {
    "node": "26.7.0",
    "npm": "11.19.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": true,
    "fsevents": false
  }
}
