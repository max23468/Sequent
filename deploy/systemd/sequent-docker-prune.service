[Unit]
Description=Pulizia selettiva immagini Docker Sequent
ConditionPathExists=/opt/sequent/runtime/runtime.env

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/sequent-prune-docker-images
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock
RestrictAddressFamilies=AF_UNIX
