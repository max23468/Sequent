	<xs:complexType name="DatiCatastaliFabbricati_Type">
		<xs:sequence>
			<xs:element name="SezioneUrbana" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="cm:DatoAN_Type">
						<xs:maxLength value="3"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ZonaCensuaria" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="cm:DatoAN_Type">
						<xs:maxLength value="3"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CategoriaCatastale" type="reg:CodiciCategoriaCatastale_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Obbligatorio se 'Provincia' diverso da 'EE''
Se 'provincia' = 'EE' non valorizzare. 
In presenza di agevolazione “P” o "Z" la categoria catastale deve essere “A” escluso A1, A8, A9 e A10 oppure F3. 
In presenza di agevolazione “X” o "Y" la categoria catastale deve essere C/2, C/6 o C/7. 
In presenza del campo diritto di abitazione con valore = 1 o 2 o 5 o 6 la categoria catastale deve essere “A” escluso A1, A8, A9 e A10 oppure F3. 
In presenza del campo diritto di abitazione con valore = 3 o 7 la categoria catastale deve essere C/2, C/6 o C/7
</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Classe" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="cm:DatoAN_Type">
						<xs:maxLength value="2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Consistenza" type="cm:DatoVP_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Dato obbligatorio se il campo 'categoria' assume valori da 'A1' ad 'A11', da B1 a B8, da C1 a C7. 
Non valorizzare per tutti gli altri valori del campo 'Categoria'. (Il campo non va compilato per gli immobili censiti nelle categorie D, E o non classati)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RenditaCatastale" type="cm:DatoVP_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Obbligatoria se categoria ha un valore diverso da F1, F2, F3, F4, F5, F6, F7. 
Non può essere compilata se categoria ha un valore uguale a F1, F2, F3, F4, F5, F6, F7
Obbligatoria se categoria catastale è uguale a D10 e valore = 0</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DeterminazioneRendita" type="reg:DeterminazioneRendita_Type" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Obbligatorio se 'Rendita catastale' non valorizzato e provincia diversa da 'EE' e se categoria ha un valore diverso da F1, F2, F3, F4, F5, F6, F7. 
Se categoria ha valore F1, F2, F3, F4, F5, F6, F7 non può essere presente. 
Se 'provincia' = 'EE' non valorizzare. </xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DatiCatastaliFabbricatiTavolare_Type">
		<xs:sequence>
			<xs:element name="SezioneUrbana" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="cm:DatoAN_Type">
						<xs:maxLength value="3"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ZonaCensuaria" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="cm:DatoAN_Type">
