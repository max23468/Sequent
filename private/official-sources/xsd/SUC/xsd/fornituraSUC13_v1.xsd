					<xs:documentation><![CDATA[Proprieta' per l'area]]></xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="2">
				<xs:annotation>
					<xs:documentation><![CDATA[Nuda proprieta']]></xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="2S">
				<xs:annotation>
					<xs:documentation><![CDATA[Nuda proprieta' superficiaria]]></xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="2T">
				<xs:annotation>
					<xs:documentation><![CDATA[Nuda proprieta' per l'area]]></xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="4">
				<xs:annotation>
					<xs:documentation><![CDATA[Diritto del concedente]]></xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="5">
				<xs:annotation>
					<xs:documentation><![CDATA[Diritto dell'enfiteuta]]></xs:documentation>
