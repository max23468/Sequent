											</xs:element>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element name="QuadroEO" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Non deve essere presente se 'Dichiarazione sostitutiva è uguale a '3'</xs:documentation>
						</xs:annotation>
						<xs:complexType>
							<xs:sequence>
