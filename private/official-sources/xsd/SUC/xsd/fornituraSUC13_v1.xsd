	<xs:simpleType name="CodiciDirittoUsufrutto">
		<xs:annotation>
			<xs:documentation>Elenco dei CODICI DIRITTO usufrutto</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
