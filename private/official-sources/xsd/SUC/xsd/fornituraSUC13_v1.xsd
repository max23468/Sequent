	<xs:element name="Fornitura" substitutionGroup="tm:Fornitura">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Intestazione">
					<xs:complexType>
						<xs:complexContent>
							<xs:extension base="suc:Intestazione_Type"/>
